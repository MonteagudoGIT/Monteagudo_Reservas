# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube a git.

# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=
# Contraseña de la base de datos (la que generó el proyecto)
SUPABASE_DB_PASSWORD=
# Account -> Access Tokens (para la CLI de Supabase)
SUPABASE_ACCESS_TOKEN=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email ----
# Los correos de autenticación (verificación, recuperación) se envían por el SMTP
# de Gmail configurado dentro de Supabase (Auth -> SMTP Settings).
# Estos son para los correos que manda la app (recordatorios de transferencia del cron):
SMTP_USER=comunidadmontegadudo.noreply@gmail.com
SMTP_PASS=            # contraseña de aplicación de Gmail (16 caracteres, sin espacios)
# opcionales (tienen valor por defecto):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Monteagudo <comunidadmontegadudo.noreply@gmail.com>

# ---- Cron ----
# Secreto que Vercel envía como "Authorization: Bearer <CRON_SECRET>" al llamar /api/cron/reservas
CRON_SECRET=
