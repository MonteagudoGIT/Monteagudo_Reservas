# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se sube a git.

# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF=
# Contraseña de la base de datos (la que generó el proyecto)
SUPABASE_DB_PASSWORD=
# Account -> Access Tokens (para la CLI de Supabase)
SUPABASE_ACCESS_TOKEN=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email ----
# Los correos de autenticación (verificación, recuperación) se configuran como
# SMTP de Resend dentro de Supabase (Auth -> SMTP Settings). No hace falta clave aquí todavía.
# Para los correos propios de la app (código de acceso, avisos) - más adelante:
RESEND_API_KEY=
EMAIL_FROM=Monteagudo <reservas@tu-dominio>
